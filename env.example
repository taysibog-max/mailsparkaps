# Server Configuration
PORT=3010

# SMTP Configuration (existing)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
FROM_EMAIL=noreply@example.com

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Brevo (Sendinblue) Configuration
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_NAME=Your Store
BREVO_SENDER_EMAIL=noreply@yourstore.com

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here
# URL where customer can complete checkout
CHECKOUT_URL=https://yourstore.com/checkout

# Cart Monitoring Configuration
# Time in minutes before cart is considered abandoned (default: 30)
CART_ABANDONMENT_MINUTES=30
# Cron schedule for checking abandoned carts (default: every 10 minutes)
CART_CHECK_SCHEDULE=*/10 * * * *
# Run scheduler immediately on server start (true/false)
RUN_SCHEDULER_ON_START=false







